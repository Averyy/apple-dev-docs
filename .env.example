# Apple Docs MCP Server - Environment Configuration

# =============================================================================
# REQUIRED
# =============================================================================

# Meilisearch master key (generate with: openssl rand -hex 32)
MEILI_MASTER_KEY=

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================

# Meilisearch URL (default: http://localhost:7700)
MEILI_HTTP_ADDR=http://localhost:7700

# HTTP port for MCP server (default: 8000)
HTTP_PORT=8000

# Rate limiting - requests per minute (default: 60)
RATE_LIMIT_REQUESTS=60

# API key for rate limit bypass (generate with: openssl rand -hex 32)
# If set, requests with valid Authorization header bypass rate limits
MCP_API_KEY=

# Public hostnames allowed in the Host header, comma-separated (default: xdocs.dev,www.xdocs.dev)
# localhost/127.0.0.1/::1 are always allowed. Requests with other Host headers get 421.
ALLOWED_HOSTS=xdocs.dev,www.xdocs.dev

# =============================================================================
# OPTIONAL - Meilisearch Keys (auto-generated from MEILI_MASTER_KEY if not set)
# =============================================================================

# Read-only search key (for search operations)
# MEILI_SEARCH_KEY=

# Admin key (for indexing operations)
# MEILI_ADMIN_KEY=

# =============================================================================
# OPTIONAL - Health Check Configuration
# =============================================================================

# Minimum docs for "healthy" status (default: 290000, ~90% of full corpus)
# MIN_EXPECTED_DOCS=290000

# Expected full index size for progress calculation (default: 322000)
# EXPECTED_FULL_INDEX_SIZE=322000

# Meilisearch connection timeout in seconds (default: 10)
# MEILI_TIMEOUT=10

# Max retries for transient errors (default: 2)
# MEILI_MAX_RETRIES=2