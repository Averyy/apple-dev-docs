# Apple Docs MCP Server - Environment Configuration

# =============================================================================
# REQUIRED
# =============================================================================

# Meilisearch master key (generate with: openssl rand -hex 32)
MEILI_MASTER_KEY=

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================

# Meilisearch URL (default: http://localhost:7700)
MEILI_HTTP_ADDR=http://localhost:7700

# HTTP port for MCP server (default: 8000)
HTTP_PORT=8000

# Rate limiting - requests per minute per client address (default: 60)
RATE_LIMIT_REQUESTS=60

# Requests per minute per address of the AI platforms' published connector ranges
# (default: 1000). Claude.ai and ChatGPT call connectors from their own servers, so all
# their users share those addresses; this limit only protects the server
PLATFORM_RATE_LIMIT=1000

# The two below have their defaults in the server code only, and docker-compose.yml doesn't
# pass them: they apply when running the server outside Docker (add them to the compose
# file's environment to override them in Docker)
# Anthropic's outbound ranges, comma-separated (default: 160.79.104.0/21,153.61.208.0/20)
# PLATFORM_CIDRS=160.79.104.0/21,153.61.208.0/20

# OpenAI's ChatGPT connector ranges (default: mcp-server/chatgpt-connectors.json, which CI
# refreshes from https://openai.com/chatgpt-connectors.json on every image build)
# OPENAI_RANGES_FILE=

# API key for rate limit bypass (generate with: openssl rand -hex 32)
# If set, requests with valid Authorization header bypass rate limits
MCP_API_KEY=

# Public hostnames allowed in the Host header, comma-separated (default: xdocs.dev,www.xdocs.dev)
# localhost/127.0.0.1/::1 are always allowed. Requests with other Host headers get 421.
ALLOWED_HOSTS=xdocs.dev,www.xdocs.dev

# =============================================================================
# OPTIONAL - Meilisearch Keys (auto-generated from MEILI_MASTER_KEY if not set)
# =============================================================================

# Read-only search key (for search operations)
# MEILI_SEARCH_KEY=

# Admin key (for indexing operations)
# MEILI_ADMIN_KEY=

# =============================================================================
# OPTIONAL - Health Check Configuration
# =============================================================================

# Minimum docs for "healthy" status (default: 363000, ~90% of full corpus)
# MIN_EXPECTED_DOCS=363000

# Expected full index size for progress calculation (default: 404000)
# EXPECTED_FULL_INDEX_SIZE=404000

# Meilisearch connection timeout in seconds (default: 10)
# MEILI_TIMEOUT=10

# Max retries for transient errors (default: 2)
# MEILI_MAX_RETRIES=2